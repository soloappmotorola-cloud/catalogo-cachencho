---
import movies from '../../public/data/movies.json';
import series from '../../public/data/series.json';
import suggestions from '../../public/data/suggestions.json';

function groupByCategory(items: { category: string }[]) {
  const groups = new Map<string, typeof items>();
  for (const item of items) {
    if (!groups.has(item.category)) groups.set(item.category, []);
    groups.get(item.category)!.push(item);
  }
  return [...groups.entries()];
}

const suggestionCategories = groupByCategory(suggestions);

function uniqueGenres(items: { genres: string[] }[]) {
  const set = new Set<string>();
  for (const item of items) {
    for (const genre of item.genres) set.add(genre);
  }
  return [...set].sort((a, b) => a.localeCompare(b, 'es'));
}

const movieGenreList = uniqueGenres(movies);
const seriesGenreList = uniqueGenres(series);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Catálogo Cachencho</title>
  </head>
  <body>
    <header class="site-header">
      <h1>Catálogo Cachencho</h1>
      <p class="subtitle">Lo que hay para ver ahora mismo. Página temporal, compartida solo con ustedes.</p>
      <nav class="top-nav">
        <a href="#sugerencias">Sugerencias</a>
        <a href="#peliculas">Películas ({movies.length})</a>
        <a href="#series">Series ({series.length})</a>
      </nav>
    </header>

    <main>
      <section id="sugerencias" class="suggestions-section">
        <h2 class="section-title">Sugerencias de Cachencho</h2>
        <p class="suggestions-caption">Todavía no están en el catálogo. Votá 👌 la que quieras que bajemos.</p>
        {
          suggestionCategories.map(([category, items]) => (
            <div class="genre-block">
              <h3 class="genre-title">{category}</h3>
              <div class="suggestion-grid">
                {items.map((item) => (
                  <article class="suggestion-card" data-suggestion-id={item.id}>
                    <img src={item.posterUrl} alt={item.title} loading="lazy" width="500" height="750" />
                    <div class="suggestion-body">
                      <p class="suggestion-title">
                        {item.title} <span class="year">({item.year})</span>
                      </p>
                      <p class="suggestion-director">{item.director}</p>
                      <p class="suggestion-desc">{item.description}</p>
                      <button class="vote-btn" type="button" aria-pressed="false">
                        <span class="vote-emoji">👌</span>
                        <span class="vote-label">Votar</span>
                        <span class="vote-count">0</span>
                      </button>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))
        }
      </section>

      <section id="peliculas" class="browse-section">
        <h2 class="section-title">Películas ({movies.length})</h2>
        <div class="genre-filter" role="group" aria-label="Filtrar películas por género">
          <button class="chip active" type="button" data-genre="">Todos</button>
          {movieGenreList.map((genre) => (
            <button class="chip" type="button" data-genre={genre}>{genre}</button>
          ))}
        </div>
        <div class="grid">
          {movies.map((item) => (
            <article class="card" data-genres={item.genres.join('|')}>
              {item.posterUrl ? (
                <img src={item.posterUrl} alt={item.title} loading="lazy" width="500" height="750" />
              ) : (
                <div class="no-poster">{item.title}</div>
              )}
              <p class="card-title">
                {item.title} {item.year ? <span class="year">({item.year})</span> : null}
              </p>
              <p class="card-genres">{item.genres.join(' · ')}</p>
            </article>
          ))}
        </div>
        <p class="empty-state" hidden>Nada con ese género.</p>
      </section>

      <section id="series" class="browse-section">
        <h2 class="section-title">Series ({series.length})</h2>
        <div class="genre-filter" role="group" aria-label="Filtrar series por género">
          <button class="chip active" type="button" data-genre="">Todos</button>
          {seriesGenreList.map((genre) => (
            <button class="chip" type="button" data-genre={genre}>{genre}</button>
          ))}
        </div>
        <div class="grid">
          {series.map((item) => (
            <article class="card" data-genres={item.genres.join('|')}>
              {item.posterUrl ? (
                <img src={item.posterUrl} alt={item.title} loading="lazy" width="500" height="750" />
              ) : (
                <div class="no-poster">{item.title}</div>
              )}
              <p class="card-title">
                {item.title} {item.year ? <span class="year">({item.year})</span> : null}
              </p>
              <p class="card-genres">{item.genres.join(' · ')}</p>
            </article>
          ))}
        </div>
        <p class="empty-state" hidden>Nada con ese género.</p>
      </section>
    </main>

    <footer class="site-footer">
      <p>Página no indexada — no la compartas más allá de este link.</p>
    </footer>

    <script>
      // "cachencho-votados" recuerda, por navegador, en qué sugerencias YA votó esta persona
      // (para no dejarla sumar de nuevo al recargar). El conteo real y compartido entre todos
      // los que entran vive en el servidor (Netlify Blobs vía /api/votes), no acá.
      const VOTED_KEY = 'cachencho-votados';

      function loadVoted(): Record<string, true> {
        try {
          return JSON.parse(localStorage.getItem(VOTED_KEY) ?? '{}');
        } catch {
          return {};
        }
      }

      function saveVoted(voted: Record<string, true>) {
        try {
          localStorage.setItem(VOTED_KEY, JSON.stringify(voted));
        } catch {
          // localStorage no disponible (modo privado, etc.) — el estado de "ya voté" no persiste, no rompe la página.
        }
      }

      const votedByMe = loadVoted();
      const cards = document.querySelectorAll<HTMLElement>('.suggestion-card');

      function setButtonState(card: HTMLElement, voted: boolean, count: number) {
        const btn = card.querySelector<HTMLButtonElement>('.vote-btn');
        const countEl = card.querySelector<HTMLElement>('.vote-count');
        if (!btn || !countEl) return;
        btn.setAttribute('aria-pressed', String(voted));
        btn.classList.toggle('voted', voted);
        countEl.textContent = String(count);
      }

      // Estado inicial optimista (por si /api/votes tarda o falla): 0, o 1 si esta persona ya votó antes.
      cards.forEach((card) => {
        const id = card.dataset.suggestionId;
        if (!id) return;
        setButtonState(card, Boolean(votedByMe[id]), votedByMe[id] ? 1 : 0);
      });

      fetch('/api/votes')
        .then((res) => (res.ok ? res.json() : {}))
        .then((counts: Record<string, number>) => {
          cards.forEach((card) => {
            const id = card.dataset.suggestionId;
            if (!id) return;
            setButtonState(card, Boolean(votedByMe[id]), counts[id] ?? 0);
          });
        })
        .catch(() => {
          // Sin conexión a la función (ej. corriendo con `astro dev` sin `netlify dev`) — se queda con el estado local.
        });

      cards.forEach((card) => {
        const id = card.dataset.suggestionId;
        if (!id) return;
        const btn = card.querySelector<HTMLButtonElement>('.vote-btn');
        const countEl = card.querySelector<HTMLElement>('.vote-count');
        if (!btn || !countEl) return;

        btn.addEventListener('click', async () => {
          const isVoted = btn.getAttribute('aria-pressed') === 'true';
          const next = !isVoted;
          const delta = next ? 1 : -1;

          // Optimista: refleja el cambio antes de esperar la respuesta del servidor.
          const optimisticCount = Math.max(0, Number(countEl.textContent) + delta);
          setButtonState(card, next, optimisticCount);
          if (next) votedByMe[id] = true; else delete votedByMe[id];
          saveVoted(votedByMe);

          try {
            const res = await fetch('/api/votes', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id, delta }),
            });
            if (res.ok) {
              const data = await res.json();
              setButtonState(card, next, data.count);
            }
          } catch {
            // Sin conexión a la función — se queda con el conteo optimista local.
          }
        });
      });

      document.querySelectorAll<HTMLElement>('.browse-section').forEach((section) => {
        const chips = section.querySelectorAll<HTMLButtonElement>('.chip');
        const cards = section.querySelectorAll<HTMLElement>('.card');
        const emptyState = section.querySelector<HTMLElement>('.empty-state');

        chips.forEach((chip) => {
          chip.addEventListener('click', () => {
            chips.forEach((c) => c.classList.remove('active'));
            chip.classList.add('active');

            const genre = chip.dataset.genre ?? '';
            let visibleCount = 0;
            cards.forEach((card) => {
              const genres = (card.dataset.genres ?? '').split('|');
              const show = genre === '' || genres.includes(genre);
              card.hidden = !show;
              if (show) visibleCount += 1;
            });
            if (emptyState) emptyState.hidden = visibleCount > 0;
          });
        });
      });
    </script>

    <style>
      :root {
        --bg: #0f1115;
        --bg-card: #1a1d24;
        --text: #e8e8ec;
        --text-dim: #9a9aa5;
        --accent: #6ea8fe;
        --border: #2a2d36;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
        line-height: 1.4;
      }

      .site-header {
        padding: 2.5rem 1.5rem 1.5rem;
        text-align: center;
        border-bottom: 1px solid var(--border);
      }

      .site-header h1 {
        margin: 0 0 0.4rem;
        font-size: clamp(1.6rem, 4vw, 2.4rem);
      }

      .subtitle {
        margin: 0 0 1.2rem;
        color: var(--text-dim);
      }

      .top-nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.6rem 1.5rem;
      }

      .top-nav a {
        color: var(--accent);
        text-decoration: none;
        font-weight: 600;
      }

      .top-nav a:hover {
        text-decoration: underline;
      }

      main {
        max-width: 1400px;
        margin: 0 auto;
        padding: 1.5rem;
      }

      .section-title {
        font-size: 1.8rem;
        margin: 2rem 0 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--border);
      }

      .suggestions-section {
        margin-bottom: 1rem;
      }

      .suggestions-caption {
        color: var(--text-dim);
        margin: 0 0 1.5rem;
      }

      .suggestion-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1.25rem;
      }

      .suggestion-card {
        display: flex;
        gap: 0.9rem;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 0.8rem;
      }

      .suggestion-card img {
        flex: 0 0 auto;
        width: 90px;
        height: 135px;
        object-fit: cover;
        border-radius: 6px;
        background: var(--bg);
      }

      .suggestion-body {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        min-width: 0;
      }

      .suggestion-title {
        margin: 0;
        font-weight: 600;
        font-size: 0.95rem;
        line-height: 1.3;
      }

      .suggestion-director {
        margin: 0;
        font-size: 0.8rem;
        color: var(--accent);
      }

      .suggestion-desc {
        margin: 0.15rem 0 0.5rem;
        font-size: 0.8rem;
        color: var(--text-dim);
        line-height: 1.4;
      }

      .vote-btn {
        margin-top: auto;
        align-self: flex-start;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: transparent;
        border: 1px solid var(--border);
        color: var(--text);
        border-radius: 100px;
        padding: 0.3rem 0.7rem;
        font-size: 0.8rem;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s;
      }

      .vote-btn:hover {
        border-color: var(--accent);
      }

      .vote-btn.voted {
        background: var(--accent);
        border-color: var(--accent);
        color: #0f1115;
        font-weight: 600;
      }

      .vote-emoji {
        font-size: 1rem;
      }

      .vote-count {
        font-variant-numeric: tabular-nums;
      }

      /* Sugerencias sigue agrupada por categoría — son 9 títulos, no 74 */
      .genre-block {
        margin-bottom: 2rem;
      }

      .genre-title {
        font-size: 1.1rem;
        color: var(--text-dim);
        margin: 0 0 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .genre-filter {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0 0 1.5rem;
      }

      .chip {
        background: transparent;
        border: 1px solid var(--border);
        color: var(--text-dim);
        border-radius: 100px;
        padding: 0.35rem 0.85rem;
        font-size: 0.8rem;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s, color 0.15s;
      }

      .chip:hover {
        border-color: var(--accent);
        color: var(--text);
      }

      .chip.active {
        background: var(--accent);
        border-color: var(--accent);
        color: #0f1115;
        font-weight: 600;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 165px));
        gap: 1.25rem 1rem;
      }

      .card img,
      .no-poster {
        width: 100%;
        height: auto;
        aspect-ratio: 2 / 3;
        border-radius: 8px;
        object-fit: cover;
        background: var(--bg-card);
        border: 1px solid var(--border);
      }

      .no-poster {
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-size: 0.8rem;
        padding: 0.5rem;
        color: var(--text-dim);
      }

      .card-title {
        margin: 0.5rem 0 0;
        font-size: 0.85rem;
        line-height: 1.3;
      }

      .card-genres {
        margin: 0.2rem 0 0;
        font-size: 0.72rem;
        color: var(--text-dim);
      }

      .year {
        color: var(--text-dim);
        font-weight: normal;
      }

      .empty-state {
        color: var(--text-dim);
        text-align: center;
        padding: 2rem 0;
      }

      .site-footer {
        text-align: center;
        padding: 2rem 1rem;
        color: var(--text-dim);
        font-size: 0.85rem;
      }

      @media (max-width: 480px) {
        .grid {
          grid-template-columns: repeat(auto-fill, minmax(105px, 125px));
          gap: 1rem 0.6rem;
        }
        .suggestion-card {
          flex-direction: column;
        }
        .suggestion-card img {
          width: 100%;
          height: auto;
          aspect-ratio: 2 / 3;
        }
      }
    </style>
  </body>
</html>
